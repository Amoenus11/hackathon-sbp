# Copie este archivo como .env (no se sube al repositorio) y ajuste los valores.
# Luego ejecute:  npm run configurar
#
# Usuarios de prueba. Si deja vacía una contraseña, `npm run configurar` genera una al azar
# y la muestra una sola vez en la consola.
ANALISTA_USUARIO=analista
ANALISTA_CLAVE=
ADMIN_USUARIO=admin
ADMIN_CLAVE=

# Puerto del servidor (por defecto 3000)
PUERTO=3000

# Asistente de IA (opcional). Sin clave, el asistente se muestra como «no disponible»
# y el resto de la plataforma funciona igual. También sirve un perfil de `ant auth login`.
ANTHROPIC_API_KEY=
# IA_DESACTIVADA=1
