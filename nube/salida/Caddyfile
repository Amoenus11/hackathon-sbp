# =====================================================================
#  hackathon-salida: la única puerta del asistente hacia Claude.
#
#  - El asistente (hackathon-asistente) NO tiene internet ni credencial: llama aquí por HTTP
#    (ANTHROPIC_BASE_URL=http://hackathon-salida:8080) con una credencial falsa.
#  - Aquí se cambia por la real (CLAUDE_CODE_OAUTH_TOKEN, creada con «claude setup-token» y guardada
#    en /srv/philomata/secretos/hackathon-sbp/claude.env) y se reenvía a https://api.anthropic.com.
#  - Solo pasan /v1/messages*, /v1/models* y /api/oauth/*. Todo lo demás: 403.
#  - Los registros no guardan cabeceras.
# =====================================================================
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	log {
		output stdout
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
		}
	}

	@anthropic path /v1/messages /v1/messages/* /v1/models /v1/models/* /api/oauth/*
	handle @anthropic {
		request_body {
			max_size 32MB
		}
		reverse_proxy https://api.anthropic.com {
			header_up Host api.anthropic.com
			header_up -X-Api-Key
			header_up Authorization "Bearer {env.CLAUDE_CODE_OAUTH_TOKEN}"
			flush_interval -1
		}
	}

	handle {
		respond "No permitido" 403
	}
}
