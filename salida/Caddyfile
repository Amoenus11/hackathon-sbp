# =====================================================================
#  hackathon-salida: la única puerta del analista hacia la IA.
#
#  - El analista (hackathon-asistente) NO tiene internet ni clave: llama aquí por HTTP
#    (ANTHROPIC_BASE_URL=http://hackathon-salida:8080) con una clave falsa.
#  - Aquí se quita esa clave, se pone la real (ANTHROPIC_API_KEY, que llega por env_file
#    desde /srv/philomata/secretos/...) y se reenvía a https://api.anthropic.com.
#  - Solo se reenvían /v1/messages, /v1/messages/count_tokens y /v1/models*. Todo lo demás: 403.
#  - Los registros no guardan cabeceras (ni la de entrada ni las de Anthropic).
#
#  Contenedor (en el compose): imagen caddy:2.11.9-alpine fijada por huella, usuario 1000,
#  read_only + tmpfs /tmp, XDG_CONFIG_HOME=/tmp/config y XDG_DATA_HOME=/tmp/data,
#  redes: «hackathon-ia» (interna, con el analista) + una red con salida a internet.
# =====================================================================
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	log {
		output stdout
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
		}
	}

	@anthropic path /v1/messages /v1/messages/count_tokens /v1/models /v1/models/*
	handle @anthropic {
		request_body {
			max_size 32MB
		}
		reverse_proxy https://api.anthropic.com {
			header_up Host api.anthropic.com
			header_up -Authorization
			header_up X-Api-Key {env.ANTHROPIC_API_KEY}
			flush_interval -1
		}
	}

	handle {
		respond "No permitido" 403
	}
}
